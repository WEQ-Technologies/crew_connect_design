{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/",
      "destination": "/v5/",
      "permanent": false
    },
    {
      "source": "/v5",
      "destination": "/v5/",
      "permanent": false
    },
    {
      "source": "/v4",
      "destination": "/v4/",
      "permanent": false
    },
    {
      "source": "/v4/glass",
      "destination": "/v4/",
      "permanent": false
    },
    {
      "source": "/v1",
      "destination": "/v1/",
      "permanent": false
    },
    {
      "source": "/v2",
      "destination": "/v2/glass/",
      "permanent": false
    },
    {
      "source": "/v2/glass",
      "destination": "/v2/glass/",
      "permanent": false
    },
    {
      "source": "/v3",
      "destination": "/v3/bento/",
      "permanent": false
    },
    {
      "source": "/v3/bento",
      "destination": "/v3/bento/",
      "permanent": false
    },
    {
      "source": "/Prototype.dc.html",
      "destination": "/v4/",
      "permanent": false
    },
    {
      "source": "/prototype.dc.html",
      "destination": "/v4/",
      "permanent": false
    },
    {
      "source": "/prototype",
      "destination": "/v4/",
      "permanent": false
    },
    {
      "source": "/Prototype",
      "destination": "/v4/",
      "permanent": false
    },
    {
      "source": "/Journeys.dc.html",
      "destination": "/v4/",
      "permanent": false
    },
    {
      "source": "/journeys.dc.html",
      "destination": "/v4/",
      "permanent": false
    },
    {
      "source": "/v1/Prototype.dc.html",
      "destination": "/v1/",
      "permanent": false
    },
    {
      "source": "/v1/prototype.dc.html",
      "destination": "/v1/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:screen.dc.html",
      "destination": "/v1/:screen.dc.html"
    },
    {
      "source": "/_blob/:id",
      "destination": "/assets/:id.png"
    },
    {
      "source": "/v5/_blob/:id",
      "destination": "/v5/assets/:id.png"
    },
    {
      "source": "/v4/_blob/:id",
      "destination": "/v4/assets/:id.png"
    },
    {
      "source": "/v3/bento/_blob/:id",
      "destination": "/v3/bento/assets/:id.png"
    },
    {
      "source": "/v2/glass/_blob/:id",
      "destination": "/v2/glass/assets/:id.png"
    },
    {
      "source": "/v3/_blob/:id",
      "destination": "/v3/bento/assets/:id.png"
    },
    {
      "source": "/v2/_blob/:id",
      "destination": "/v2/glass/assets/:id.png"
    },
    {
      "source": "/v1/_blob/:id",
      "destination": "/v1/assets/:id.png"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/v1/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/v2/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/v3/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/v5",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/v5/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/v4",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/v4/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/v1/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/v2/glass/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/v3/bento/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/v4/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/v5/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}