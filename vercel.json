{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/",
      "destination": "/v3",
      "permanent": false
    },
    {
      "source": "/v1",
      "destination": "/v1/",
      "permanent": false
    },
    {
      "source": "/v2",
      "destination": "/v2/",
      "permanent": false
    },
    {
      "source": "/v3",
      "destination": "/v3/",
      "permanent": false
    },
    {
      "source": "/Prototype.dc.html",
      "destination": "/v3",
      "permanent": false
    },
    {
      "source": "/prototype.dc.html",
      "destination": "/v3",
      "permanent": false
    },
    {
      "source": "/prototype",
      "destination": "/v3",
      "permanent": false
    },
    {
      "source": "/Prototype",
      "destination": "/v3",
      "permanent": false
    },
    {
      "source": "/Journeys.dc.html",
      "destination": "/v3",
      "permanent": false
    },
    {
      "source": "/journeys.dc.html",
      "destination": "/v3",
      "permanent": false
    },
    {
    "source": "/v1/Prototype.dc.html",
    "destination": "/v1/",
    "permanent": false
  },
  {
    "destination": "/v1/",
    "permanent": false
  }
"rewrites": [
  {
    "destination": "/v1/:screen.dc.html"
  },
  {
  "source": "/_blob/:id",
  "destination": "/assets/:id.png"
},
{
"source": "/v3/_blob/:id",
"destination": "/v3/assets/:id.png"
},
{
"destination": "/v2/assets/:id.png"
},
{
"source": "/v1/_blob/:id",
"destination": "/v1/assets/:id.png"
}
],
"headers": [
{
"headers": [
{
  "key": "Access-Control-Allow-Origin",
  "value": "*"
}
]
},
{
"source": "/v1/(.*)",
"headers": [
{
  "key": "Cache-Control",
  "value": "public, max-age=0, must-revalidate"
}
]
},
{
"source": "/v2",
"headers": [
{
  "key": "Content-Type",
  "value": "text/html; charset=utf-8"
},
{
  "key": "Cache-Control",
  "value": "public, max-age=0, must-revalidate"
}
]
},
{
"source": "/v2/(.*)",
"headers": [
{
  "key": "Cache-Control",
  "value": "public, max-age=0, must-revalidate"
}
]
},
{
"source": "/v3",
"headers": [
{
  "key": "Content-Type",
  "value": "text/html; charset=utf-8"
},
{
  "key": "Cache-Control",
  "value": "public, max-age=0, must-revalidate"
}
]
},
{
"source": "/v3/(.*)",
"headers": [
{
  "key": "Cache-Control",
  "value": "public, max-age=0, must-revalidate"
}
]
},
{
"source": "/assets/(.*)",
"headers": [
{
  "key": "Cache-Control",
  "value": "public, max-age=31536000, immutable"
}
]
},
{
"source": "/v1/assets/(.*)",
"headers": [
{
  "key": "Cache-Control",
  "value": "public, max-age=31536000, immutable"
}
]
},
{
"source": "/v2/assets/(.*)",
"headers": [
{
  "key": "Cache-Control",
  "value": "public, max-age=31536000, immutable"
}
]
},
{
"source": "/v3/assets/(.*)",
"headers": [
{
  "key": "Cache-Control",
  "value": "public, max-age=31536000, immutable"
}
]
}
]
}