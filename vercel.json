{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/Prototype.dc.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/prototype.dc.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/Journeys.dc.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/journeys.dc.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/prototype",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/Prototype",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/_blob/:id",
      "destination": "/assets/:id.png"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
